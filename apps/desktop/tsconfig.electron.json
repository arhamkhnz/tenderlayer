{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "electron"],
    "rootDir": "src",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "declaration": true,
    "declarationDir": "./node_modules/.tmp/types/electron",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "strict": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "src/types/**/*.d.ts"]
}
