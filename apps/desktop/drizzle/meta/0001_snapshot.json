      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "contracts_title_check": {
          "name": "contracts_title_check",
          "value": "length(\"contracts\".\"title\") > 0 and \"contracts\".\"title\" = trim(\"contracts\".\"title\")"
        },
        "contracts_status_check": {
          "name": "contracts_status_check",
          "value": "\"contracts\".\"status\" in ('draft', 'wo-received', 'scheduled', 'active', 'on-hold', 'completed', 'terminated')"
        },
        "contracts_non_draft_fields_check": {
          "name": "contracts_non_draft_fields_check",
          "value": "\"contracts\".\"status\" = 'draft' or (\n        \"contracts\".\"department_id\" is not null\n        and coalesce(length(trim(\"contracts\".\"gem_reference\")), 0) > 0\n        and coalesce(length(trim(\"contracts\".\"location_state\")), 0) > 0\n        and coalesce(length(trim(\"contracts\".\"location_city\")), 0) > 0\n        and \"contracts\".\"amount\" is not null\n        and \"contracts\".\"start_date\" is not null\n        and \"contracts\".\"duration\" is not null\n        and \"contracts\".\"required_headcount\" is not null\n      )"
        },
        "contracts_amount_check": {
          "name": "contracts_amount_check",
          "value": "\"contracts\".\"amount\" is null or (typeof(\"contracts\".\"amount\") = 'integer' and \"contracts\".\"amount\" >= 0)"
        },
        "contracts_currency_check": {
          "name": "contracts_currency_check",
          "value": "\"contracts\".\"currency\" glob '[A-Z][A-Z][A-Z]'"
        },
        "contracts_includes_tax_check": {
          "name": "contracts_includes_tax_check",
          "value": "\"contracts\".\"includes_tax\" in (0, 1)"
        },
        "contracts_duration_check": {
          "name": "contracts_duration_check",
          "value": "\"contracts\".\"duration\" is null or (typeof(\"contracts\".\"duration\") = 'integer' and \"contracts\".\"duration\" > 0)"
        },
        "contracts_duration_unit_check": {
          "name": "contracts_duration_unit_check",
          "value": "\"contracts\".\"duration_unit\" in ('days', 'months', 'years')"
        },
        "contracts_date_order_check": {
          "name": "contracts_date_order_check",
          "value": "\"contracts\".\"start_date\" is null or \"contracts\".\"end_date\" is null or \"contracts\".\"end_date\" >= \"contracts\".\"start_date\""
        },
        "contracts_required_headcount_check": {
          "name": "contracts_required_headcount_check",
          "value": "\"contracts\".\"required_headcount\" is null or (typeof(\"contracts\".\"required_headcount\") = 'integer' and \"contracts\".\"required_headcount\" >= 0)"
        },
        "contracts_deployed_headcount_check": {
          "name": "contracts_deployed_headcount_check",
          "value": "typeof(\"contracts\".\"deployed_headcount\") = 'integer' and \"contracts\".\"deployed_headcount\" >= 0"
        }
