{
  "name": "@tenderlayer/desktop",
  "productName": "TenderLayer",
  "description": "A production-ready Electron, React, TypeScript, and Vite foundation.",
  "author": "Arham Khan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build": "tsc -b && node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "electron scripts/db-studio.mjs",
    "lint": "oxlint --config ../../oxlint.config.ts .",
    "lint:fix": "oxlint --config ../../oxlint.config.ts --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "npm run lint:fix && npm run format",
    "preview:renderer": "vite preview",
    "postinstall": "npm run rebuild:native",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "start": "electron .",
    "check-types": "tsc -b",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@keyline-icons/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^9.2.6",
    "@tenderlayer/ui": "^0.0.0",
    "better-sqlite3": "^13.0.3",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
