{
  "name": "@tenderlayer/desktop",
  "productName": "TenderLayer",
  "description": "A production-ready Electron, React, TypeScript, and Vite foundation.",
  "author": "Arham Khan",
  "private": true,
  "version": "0.1.0-alpha.4",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build": "tsc -b && node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "electron scripts/db-studio.mjs",
    "lint": "oxlint --config ../../oxlint.config.ts .",
    "lint:fix": "oxlint --config ../../oxlint.config.ts --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "npm run lint:fix && npm run format",
    "preview:renderer": "vite preview",
    "postinstall": "npm run rebuild:native",
    "rebuild:native": "electron-builder install-app-deps",
    "start": "electron .",
    "check-types": "tsc -b",
    "package": "electron-builder --dir --publish never",
    "make": "electron-builder --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "electron-store": "^12.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@hookform/resolvers": "^5.9.2",
    "@keyline-icons/react": "^2.7.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@tenderlayer/fonts": "^0.0.0",
    "@tenderlayer/ui": "^0.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.11",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
