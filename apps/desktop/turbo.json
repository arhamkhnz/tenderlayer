{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "node_modules/.tmp/**"]
    },
    "check-types": {
      "outputs": ["node_modules/.tmp/**"]
    },
    "dev": {
      "passThroughEnv": ["TENDERLAYER_DB_PATH"]
    },
    "dev:renderer": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "passThroughEnv": ["TENDERLAYER_DB_PATH"]
    },
    "preview:renderer": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TENDERLAYER_DB_PATH", "npm_node_execpath"]
    },
    "rebuild:native": {
      "cache": false
    },
    "package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "make": {
      "dependsOn": ["build"],
      "cache": false
    },
    "fix": {
      "cache": false
    }
  }
}
