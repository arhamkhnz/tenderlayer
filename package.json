{
  "name": "tenderlayer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@tenderlayer/desktop",
    "dev:site": "turbo run dev --filter=tenderlayer-site",
    "dev:renderer": "turbo run dev:renderer --filter=@tenderlayer/desktop",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@tenderlayer/desktop",
    "build:site": "turbo run build --filter=tenderlayer-site",
    "start:desktop": "turbo run start --filter=@tenderlayer/desktop",
    "start:site": "turbo run start --filter=tenderlayer-site",
    "preview:renderer": "turbo run preview:renderer --filter=@tenderlayer/desktop",
    "db:generate": "turbo run db:generate --filter=@tenderlayer/desktop",
    "db:studio": "turbo run db:studio --filter=@tenderlayer/desktop",
    "rebuild:native": "turbo run rebuild:native --filter=@tenderlayer/desktop",
    "package": "turbo run package --filter=@tenderlayer/desktop",
    "make": "turbo run make --filter=@tenderlayer/desktop",
    "lint": "turbo run lint",
    "lint:fix:desktop": "turbo run lint:fix --filter=@tenderlayer/desktop",
    "fix:desktop": "turbo run fix --filter=@tenderlayer/desktop",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:fix:root": "oxlint --config oxlint.config.ts --fix *.ts",
    "fix": "turbo run lint:fix lint:fix:root && oxfmt",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
